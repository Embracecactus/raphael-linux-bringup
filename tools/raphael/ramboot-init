#!/bin/busybox sh
# Minimal PID 1 for the Raphael RAM-only Linux acceptance image.
# Safety invariant: do not mount, format, or write any block device.

BB=/bin/busybox
export PATH=/bin
export HOME=/root

# Install applet symlinks into the writable initramfs, then mount only virtual
# or memory-backed filesystems.  No /dev/block or /dev/disk path is consumed.
"$BB" --install -s /bin
mkdir -p /dev /dev/pts /proc /sys /sys/kernel/config /run /tmp /root /etc
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
mount -t configfs configfs /sys/kernel/config

exec </dev/console >/dev/console 2>&1
hostname raphael-ramboot

say()
{
	printf '[raphael-ramboot] %s\n' "$*"
	if [ -c /dev/kmsg ]; then
		printf '<6>raphael-ramboot: %s\n' "$*" >/dev/kmsg
	fi
}

say 'RAMBOOT_INIT_STARTED'
say "kernel=$(uname -r) arch=$(uname -m)"
if [ -r /sys/firmware/devicetree/base/model ]; then
	model=$(tr -d '\000' </sys/firmware/devicetree/base/model)
	say "model=$model"
fi
say 'storage-policy=no-block-device-mount-or-write'

start_usb_debug()
{
	gadget=/sys/kernel/config/usb_gadget/raphael_ramboot

	# Give the Qualcomm UDC up to 30 seconds to finish probing.
	tries=0
	while [ "$tries" -lt 30 ]; do
		set -- /sys/class/udc/*
		[ -e "$1" ] && break
		tries=$((tries + 1))
		sleep 1
	done
	set -- /sys/class/udc/*
	if [ ! -e "$1" ]; then
		say 'USB_DEBUG_FAILED=no-UDC'
		return 1
	fi
	udc=${1##*/}

	mkdir -p "$gadget"
	cd "$gadget" || return 1
	echo 0x1d6b >idVendor
	echo 0x0104 >idProduct
	echo 0x0200 >bcdUSB
	echo 0x0100 >bcdDevice
	echo 0xef >bDeviceClass
	echo 0x02 >bDeviceSubClass
	echo 0x01 >bDeviceProtocol

	mkdir -p strings/0x409 configs/c.1/strings/0x409
	echo RAPHAELRAMBOOT >strings/0x409/serialnumber
	echo OpenVela-Lab >strings/0x409/manufacturer
	echo 'Raphael RAM-only Linux' >strings/0x409/product
	echo 'ACM console and NCM debug' >configs/c.1/strings/0x409/configuration
	echo 100 >configs/c.1/MaxPower

	mkdir -p functions/acm.usb0
	ln -s functions/acm.usb0 configs/c.1/acm.usb0

	# NCM is a fallback transport when a host cannot expose the ACM port.
	if mkdir functions/ncm.usb0; then
		echo 02:52:41:50:48:02 >functions/ncm.usb0/dev_addr
		echo 02:52:41:50:48:01 >functions/ncm.usb0/host_addr
		ln -s functions/ncm.usb0 configs/c.1/ncm.usb0
	fi

	echo "$udc" >UDC
	say "USB_DEBUG_BOUND=$udc"

	(
		while [ ! -c /dev/ttyGS0 ]; do sleep 1; done
		while true; do
			printf '\r\nRaphael RAM-only Linux (USB ACM)\r\n' >/dev/ttyGS0
			printf 'No phone partition is mounted. Type poweroff -f or reboot -f to exit.\r\n' >/dev/ttyGS0
			setsid cttyhack sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1
			sleep 1
		done
	) &

	(
		tries=0
		while [ "$tries" -lt 15 ] && [ ! -e /sys/class/net/usb0 ]; do
			tries=$((tries + 1))
			sleep 1
		done
		if [ -e /sys/class/net/usb0 ]; then
			ip link set usb0 up
			ip address add 172.31.7.2/30 dev usb0
			telnetd -p 2323 -l /bin/sh
			say 'USB_NCM_READY=172.31.7.2/30:2323'
		else
			say 'USB_NCM_UNAVAILABLE'
		fi
	) &
}

start_usb_debug || true
say 'RAMBOOT_READY'

# PID 1 must stay alive.  It deliberately performs no storage discovery,
# filesystem mount, swap activation, or shutdown-time sync to phone storage.
while true; do
	sleep 3600
done
