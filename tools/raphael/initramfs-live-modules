#!/bin/sh
# Keep the boot image's matching modules available after run-init removes the
# initramfs. The existing module directory on userdata remains untouched.
set -eu

if [ "${1:-}" = prereqs ]; then

	exit 0
fi

release=$(uname -r)
source_dir="/usr/lib/modules/$release"
target_dir="${rootmnt:?}/usr/lib/modules"

[ -s "$source_dir/modules.dep" ]
[ -s "$source_dir/modules.builtin.bin" ]
[ -d "$target_dir" ]

# A bind mount would still reference files deleted during run-init cleanup.
# A separate tmpfs owns the copied files and survives the root transition.
mount -n -t tmpfs -o size=128m,mode=0755,nosuid,nodev raphael-modules "$target_dir"
if ! cp -a "$source_dir" "$target_dir/"; then
	umount "$target_dir"
	exit 1
fi
echo "Raphael: modules for $release retained in RAM for userspace"
