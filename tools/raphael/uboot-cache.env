bootdelay=2
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

fastboot=fastboot -l $fastboot_addr_r usb 0
preboot=scsi scan

# This environment intentionally reads only the legacy cache boot filesystem.
# It does not mix the newer cust/vendor layout into the first hardware gate.
boot_efi=part number scsi 0 cache efi_part; if fatload scsi 0:${efi_part} ${loadaddr} EFI/BOOT/BOOTAA64.EFI; then bootefi ${loadaddr}; else echo "ERROR: no EFI/BOOT/BOOTAA64.EFI on cache"; run fastboot; fi
bootcmd=run boot_efi; pause; run menucmd

menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Boot Debian from cache=run boot_efi; pause
bootmenu_1=Enable USB fastboot diagnostics=run fastboot
bootmenu_2=Drop to shell=setenv bootretry -1
bootmenu_3=Reset device=reset
bootmenu_4=Shutdown device=poweroff
bootmenu_5=Dump environment=printenv; pause
bootmenu_6=Board info=bdinfo; pause

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
