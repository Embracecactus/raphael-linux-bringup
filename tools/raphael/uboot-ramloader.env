# Fail-closed U-Boot environment for a two-stage, RAM-only Linux boot.
# It performs no UFS scan and exposes no interactive storage command over USB.
bootdelay=0
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=

fastboot=fastboot -l $fastboot_addr_r usb 0
bootcmd=echo RAPHAEL_RAMLOADER_READY; echo Waiting for a RAM-only Android boot image over USB; run fastboot; echo RAM boot returned unexpectedly; reset
